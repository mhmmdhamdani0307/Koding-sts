```html
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>PictoBlox HOTS Debugger - KKA SD</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800;900&family=Source+Code+Pro:wght@600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Nunito', sans-serif;
      touch-action: manipulation;
    }
    .font-brand {
      font-family: 'Fredoka', cursive, sans-serif;
    }
    .font-code {
      font-family: 'Source Code Pro', monospace;
    }
    .dot-grid {
      background-color: #F8FAFD;
      background-image: radial-gradient(#CBD5E1 1.6px, transparent 1.6px);
      background-size: 18px 18px;
    }
    .block-text {
      fill: #FFFFFF;
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      font-size: 11.5px;
      dominant-baseline: central;
      pointer-events: none;
    }
    .block-text-dark {
      fill: #573A00;
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      font-size: 11.5px;
      dominant-baseline: central;
      pointer-events: none;
    }
    .draggable-block {
      touch-action: none;
      user-select: none;
      transition: filter 0.15s ease, transform 0.1s ease;
    }
    .draggable-block:hover {
      filter: brightness(1.08) drop-shadow(0 4px 6px rgba(0,0,0,0.15));
    }
    .drop-zone-highlight {
      filter: drop-shadow(0 0 8px #38BDF8) !important;
      stroke: #0284C7 !important;
      stroke-width: 2.5px !important;
    }
    .palette-trash-active {
      background-color: #FEE2E2 !important;
      border-color: #EF4444 !important;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.3) !important;
    }
    .tap-selected-block {
      outline: 3px solid #38BDF8 !important;
      outline-offset: 2px;
      animation: pulseBorder 1.2s infinite ease-in-out;
    }
    @keyframes pulseBorder {
      0%, 100% { outline-color: #38BDF8; transform: scale(1); }
      50% { outline-color: #0284C7; transform: scale(1.02); }
    }
    @keyframes pulseHint {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }
    .hint-alert-glow {
      animation: pulseHint 1s infinite ease-in-out;
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col select-none">

  <!-- MODAL: REGISTRASI NAMA SISWA SEBELUM MEMULAI -->
  <div id="startExamModal" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-gradient-to-b from-slate-900 to-slate-950 border-2 border-indigo-500 max-w-md w-full rounded-3xl p-6 sm:p-7 text-center shadow-2xl relative">
      <div class="w-16 h-16 bg-amber-400/20 text-amber-300 border-2 border-amber-400 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-3 shadow-inner">
        🤖
      </div>
      <h2 class="text-xl sm:text-2xl font-brand font-bold text-white mb-1">STS KODING & AI</h2>
      <p class="text-xs text-slate-300 mb-5 leading-relaxed">
        Selamat datang! Masukkan nama dan kelasmu sebelum memulai misi pemecahan masalah (debugging) pemrograman PictoBlox.
      </p>

      <form id="studentRegistrationForm" onsubmit="handleStartExam(event)" class="space-y-3.5 text-left">
        <div>
          <label class="block text-[11px] font-bold text-amber-300 uppercase tracking-wider mb-1">Nama Lengkap Siswa</label>
          <input id="inputStudentName" type="text" required placeholder="Contoh: Ahmad Raihan" class="w-full text-xs sm:text-sm px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-400 transition" />
        </div>
        <div>
          <label class="block text-[11px] font-bold text-amber-300 uppercase tracking-wider mb-1">Kelas & No. Absen</label>
          <input id="inputStudentClass" type="text" required placeholder="Contoh: 5A / Absen 12" class="w-full text-xs sm:text-sm px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-400 transition" />
        </div>

        <div class="bg-indigo-950/40 border border-indigo-500/30 p-3 rounded-xl text-[11px] text-indigo-200 space-y-1 mt-2">
          <div class="flex items-center gap-1.5 font-bold text-amber-300">
            <span>⏱️</span> <span>Ketentuan Ujian & Waktu:</span>
          </div>
          <p>• Waktu ujian total adalah <strong>60 Menit</strong>.</p>
          <p>• Setiap <strong>10 Menit</strong>, petunjuk tambahan (hint) untuk tiap soal akan terbuka secara bertahap.</p>
          <p>• Jika waktu habis, jawabanmu akan <strong>otomatis tersimpan</strong> ke Spreadsheet Guru.</p>
        </div>

        <button type="submit" class="w-full mt-2 py-3 bg-gradient-to-r from-indigo-600 via-indigo-500 to-amber-500 hover:from-indigo-500 hover:to-amber-400 active:scale-[0.98] text-white font-brand font-bold text-sm rounded-xl shadow-lg transition flex items-center justify-center gap-2 cursor-pointer shadow-indigo-500/25">
          <span>Mulai Kerjakan Ujian Sekarang</span>
          <span>🚀</span>
        </button>
      </form>
    </div>
  </div>

  <!-- HEADER & NAVBAR UTAMA -->
  <header class="bg-slate-800/95 border-b border-slate-700/80 sticky top-0 z-30 backdrop-blur-md px-3 sm:px-6 py-2.5 shadow-md">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2.5">
      <!-- Title & Student Profile Tag -->
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="bg-amber-400 text-amber-950 p-1.5 sm:p-2 rounded-xl text-lg sm:text-xl font-bold shadow-inner">
          🤖
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-amber-400 tracking-wider uppercase font-brand">KKA SD Kelas 5–6</span>
            <span id="headerStudentBadge" class="text-[10px] bg-emerald-500/20 text-emerald-300 font-extrabold px-2 py-0.5 rounded-full border border-emerald-400/30 hidden">
              👤 <span id="headerStudentName">Siswa</span>
            </span>
          </div>
          <h1 class="text-sm sm:text-base font-brand font-bold text-white tracking-wide">STS KODING & AI</h1>
        </div>
      </div>

      <!-- TIMER 60 MENIT & BUTTON HINT BERJENJANG -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- 60-Minute Countdown Clock -->
        <div id="examTimerContainer" class="bg-slate-950/80 border border-amber-500/50 px-2.5 sm:px-3 py-1.5 rounded-xl flex items-center gap-2 shadow-inner">
          <span class="text-xs">⏱️</span>
          <div class="flex flex-col">
            <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider">Sisa Waktu</span>
            <span id="examTimerDisplay" class="font-mono text-xs sm:text-sm font-black text-amber-400 tracking-wider">60:00</span>
          </div>
        </div>

        <!-- Hint Button (Opens Modal) -->
        <button id="btnOpenHintModal" onclick="openHintModal()" class="bg-indigo-600/90 hover:bg-indigo-600 active:scale-95 text-white text-xs font-bold px-2.5 sm:px-3 py-2 rounded-xl flex items-center gap-1.5 border border-indigo-400/40 shadow transition">
          <span class="text-sm">💡</span>
          <span class="hidden sm:inline">Bantuan (Hint)</span>
          <span id="unlockedHintsBadge" class="bg-amber-400 text-amber-950 text-[10px] px-1.5 py-0.2 rounded-full font-black">0/5</span>
        </button>
      </div>

      <!-- Question Tabs (1 to 5) -->
      <div class="flex items-center gap-1.5 bg-slate-950/60 p-1 rounded-xl border border-white/10 text-xs overflow-x-auto w-full md:w-auto justify-start md:justify-end">
        <button id="tabQ1" onclick="switchQuestion(0)" class="px-2.5 py-1.5 rounded-lg font-bold transition flex items-center gap-1 bg-indigo-600 text-white shadow">
          <span>Soal 1</span>
          <span id="badgeCheckQ1" class="text-[10px] hidden">✅</span>
        </button>
        <button id="tabQ2" onclick="switchQuestion(1)" class="px-2.5 py-1.5 rounded-lg font-bold transition flex items-center gap-1 text-slate-400 hover:text-white">
          <span>Soal 2</span>
          <span id="badgeCheckQ2" class="text-[10px] hidden">✅</span>
        </button>
        <button id="tabQ3" onclick="switchQuestion(2)" class="px-2.5 py-1.5 rounded-lg font-bold transition flex items-center gap-1 text-slate-400 hover:text-white">
          <span>Soal 3</span>
          <span id="badgeCheckQ3" class="text-[10px] hidden">✅</span>
        </button>
        <button id="tabQ4" onclick="switchQuestion(3)" class="px-2.5 py-1.5 rounded-lg font-bold transition flex items-center gap-1 text-slate-400 hover:text-white">
          <span>Soal 4</span>
          <span id="badgeCheckQ4" class="text-[10px] hidden">✅</span>
        </button>
        <button id="tabQ5" onclick="switchQuestion(4)" class="px-2.5 py-1.5 rounded-lg font-bold transition flex items-center gap-1 text-slate-400 hover:text-white">
          <span>Soal 5</span>
          <span id="badgeCheckQ5" class="text-[10px] hidden">✅</span>
        </button>
      </div>

      <!-- Quick Action Controls (Green Flag & Stop) -->
      <div class="flex items-center gap-2">
        <button id="greenFlagBtn" onclick="togglePlaySimulation()" class="bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white text-xs sm:text-sm font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow transition">
          <span class="text-base">🚩</span>
          <span class="hidden sm:inline">Uji Jalankan</span>
        </button>
        <button id="stopSignBtn" onclick="stopSimulation()" class="bg-rose-500 hover:bg-rose-600 active:scale-95 text-white text-xs sm:text-sm font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow transition">
          <span class="text-base">🛑</span>
          <span class="hidden sm:inline">Hentikan</span>
        </button>
      </div>
    </div>
  </header>

  <!-- STUDY CASE HEADER PANEL -->
  <section class="bg-slate-800 border-b border-slate-700 px-3 sm:px-6 py-3">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-2.5">
      <div class="flex-1 w-full">
        <div class="flex items-center gap-2 mb-2 flex-wrap">
          <span id="caseIcon" class="text-lg">🌟</span>
          <h2 id="caseTitleBadge" class="text-sm font-brand font-bold text-amber-300">Studi Kasus 1: Permainan Toby Tiba-Tiba Macet (Instant Freeze)</h2>
        </div>
        <div id="caseDescription" class="text-xs sm:text-[13px] text-slate-200 leading-relaxed max-w-5xl bg-slate-900/60 p-3 rounded-xl border border-slate-700/70">
          <!-- Rendered dynamically -->
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN WORKSPACE: 3 KOLOM RESPONSIVE -->
  <main class="max-w-7xl mx-auto w-full p-2.5 sm:p-4 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-3.5">
    
    <!-- Kolom 1: Toolbox / Palet Balok (4 cols on lg) -->
    <div class="lg:col-span-4 bg-slate-800 rounded-2xl border border-slate-700 p-3 flex flex-col shadow-lg">
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-700">
        <div class="flex items-center gap-1.5">
          <span class="text-sm">🧰</span>
          <span class="text-xs font-brand font-bold uppercase tracking-wider text-slate-200">Kotak Balok (Toolbox)</span>
        </div>
        <span class="text-[10px] text-slate-400 bg-slate-700/60 px-2 py-0.5 rounded">Tarik / Ketuk Balok</span>
      </div>

      <!-- Delete Drop Target Notice -->
      <div id="paletteTrashDropZone" class="mb-2 p-2 rounded-xl border border-dashed border-rose-500/40 bg-rose-950/20 text-center transition-all">
        <span class="text-[11px] text-rose-300 font-bold flex items-center justify-center gap-1">
          <span>🗑️</span>
          <span>Seret balok ke sini untuk mencopot / menghapusnya</span>
        </span>
      </div>

      <!-- Palette Blocks List -->
      <div id="paletteBlocksContainer" class="flex-1 overflow-y-auto space-y-2 pr-1 max-h-[380px] lg:max-h-[520px]">
        <!-- Rendered dynamically -->
      </div>

      <!-- Tap Mode Guide -->
      <div class="mt-2.5 p-2 rounded-xl bg-slate-900/60 border border-slate-700 text-[11px] text-slate-400 flex items-center gap-2">
        <span class="text-base shrink-0">📱</span>
        <span><strong>Tips HP/Tablet:</strong> Ketuk balok di atas, lalu ketuk slot target di lembar kode untuk memasang.</span>
      </div>
    </div>

    <!-- Kolom 2: Workspace SVG Canvas (5 cols on lg) -->
    <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-300 shadow-xl flex flex-col overflow-hidden">
      <div class="bg-slate-100 border-b border-slate-200 px-3 py-2 flex items-center justify-between text-slate-800">
        <div class="flex items-center gap-2">
          <span class="text-xs font-brand font-bold uppercase text-slate-700">Lembar Kode:</span>
          <span id="workspaceQuestionLabel" class="text-xs font-mono font-bold bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded">Soal 1</span>
        </div>
        <div id="evalBadge" class="text-[10px] font-bold bg-rose-100 text-rose-700 px-2 py-0.5 rounded-full border border-rose-200">
          Kode Belum Lengkap / Error ❌
        </div>
      </div>

      <!-- Workspace Canvas with PictoBlox Dot Grid -->
      <div id="scriptWorkspaceArea" class="flex-1 dot-grid p-4 overflow-auto min-h-[440px] relative">
        <div id="codeScriptSvgContainer" class="w-full flex justify-center">
          <!-- Rendered dynamically -->
        </div>

        <!-- Zoom Controls -->
        <div class="absolute bottom-3 right-3 flex flex-col gap-1 bg-white/90 p-1 rounded-xl shadow-md border border-slate-300 text-slate-700 text-xs font-bold">
          <button onclick="adjustZoom(0.1)" class="w-7 h-7 flex items-center justify-center hover:bg-slate-100 rounded">+</button>
          <button onclick="resetZoom()" class="w-7 h-7 flex items-center justify-center hover:bg-slate-100 rounded text-[10px]">=</button>
          <button onclick="adjustZoom(-0.1)" class="w-7 h-7 flex items-center justify-center hover:bg-slate-100 rounded">-</button>
        </div>
      </div>
    </div>

    <!-- Kolom 3: Stage & Reflection (3 cols on lg) -->
    <div class="lg:col-span-3 flex flex-col gap-3">
      
      <!-- Stage Box -->
      <div class="bg-slate-800 rounded-2xl border border-slate-700 p-3 shadow-lg flex flex-col">
        <div class="flex items-center justify-between pb-1.5 mb-1.5 border-b border-slate-700 text-xs font-brand font-bold text-slate-200">
          <span class="flex items-center gap-1"><span>🎮</span> <span>Stage PictoBlox</span></span>
          <span id="stageTargetSubtext" class="text-[10px] font-mono text-amber-300">Toby vs Star & Bomb</span>
        </div>

        <!-- Live Watchers -->
        <div class="flex items-center gap-1.5 mb-2 flex-wrap" id="stageWatcherContainer">
          <div id="watcherScore" class="bg-amber-100 border border-amber-400 text-amber-950 text-xs px-2 py-0.5 rounded font-black flex items-center gap-1 shadow-sm">
            <span>⭐ score:</span>
            <span id="scoreVal" class="bg-white px-1.5 rounded text-amber-900 font-mono">0</span>
          </div>
          <div id="watcherXPos" class="bg-sky-100 border border-sky-400 text-sky-950 text-xs px-2 py-0.5 rounded font-black flex items-center gap-1 shadow-sm hidden">
            <span id="watcherXPosLabel">📍 pos x:</span>
            <span id="xPosVal" class="bg-white px-1.5 rounded text-sky-900 font-mono">0</span>
          </div>
          <div id="watcherYPos" class="bg-indigo-100 border border-indigo-400 text-indigo-950 text-xs px-2 py-0.5 rounded font-black flex items-center gap-1 shadow-sm hidden">
            <span>📍 pos y:</span>
            <span id="yPosVal" class="bg-white px-1.5 rounded text-indigo-900 font-mono">0</span>
          </div>
          <div id="watcherCarLoop" class="bg-emerald-100 border border-emerald-400 text-emerald-950 text-xs px-2 py-0.5 rounded font-black flex items-center gap-1 shadow-sm hidden">
            <span>🔄 Loop:</span>
            <span id="carLoopVal" class="bg-white px-1.5 rounded text-emerald-900 font-mono">0</span>
          </div>
          <div id="watcherBearStatus" class="bg-lime-100 border border-lime-400 text-lime-950 text-xs px-2 py-0.5 rounded font-black flex items-center gap-1 shadow-sm hidden">
            <span>🐻 Status:</span>
            <span id="bearStatusVal" class="bg-white px-1.5 rounded text-lime-900 font-mono">Di Awal</span>
          </div>
        </div>

        <!-- Canvas Frame -->
        <div class="relative w-full aspect-[4/3] bg-slate-950 rounded-xl overflow-hidden border border-slate-600 shadow-inner">
          <canvas id="gameCanvas" width="360" height="270" class="w-full h-full block"></canvas>
          <div id="stageToast" class="absolute top-2 inset-x-2 bg-slate-900/90 text-amber-300 text-[11px] font-bold py-1 px-2.5 rounded-lg border border-amber-500/40 text-center opacity-0 transition-opacity duration-300 pointer-events-none">
            Game Berjalan!
          </div>
        </div>

        <!-- Touch Move Controls (Left-Right for Q2 & Q3) -->
        <div class="hidden flex justify-center items-center gap-2 mt-2" id="stageTouchButtons">
          <button id="btnTouchLeft" class="touch-none select-none w-28 bg-indigo-700 hover:bg-indigo-600 active:bg-amber-500 text-white font-extrabold py-2.5 rounded-xl text-xs flex items-center justify-center gap-1.5 transition shadow active:scale-95">
            <span>◀</span> <span>Kiri</span>
          </button>
          <button id="btnTouchRight" class="touch-none select-none w-28 bg-indigo-700 hover:bg-indigo-600 active:bg-amber-500 text-white font-extrabold py-2.5 rounded-xl text-xs flex items-center justify-center gap-1.5 transition shadow active:scale-95">
            <span>Kanan</span> <span>▶</span>
          </button>
        </div>

        <!-- D-Pad Controls for Soal 1 (Zilong 4-Way Motion) -->
        <div class="flex flex-col items-center gap-1.5 mt-2" id="stageDPadButtons">
          <button id="btnDPadUp" class="touch-none select-none w-28 bg-indigo-700 hover:bg-indigo-600 active:bg-amber-500 text-white font-extrabold py-2 rounded-xl text-xs shadow active:scale-95 flex items-center justify-center gap-1">
            ▲ Atas
          </button>
          <div class="flex items-center gap-2">
            <button id="btnDPadLeft" class="touch-none select-none w-24 bg-indigo-700 hover:bg-indigo-600 active:bg-amber-500 text-white font-extrabold py-2 rounded-xl text-xs shadow active:scale-95 flex items-center justify-center gap-1">
              ◀ Kiri
            </button>
            <button id="btnDPadDown" class="touch-none select-none w-24 bg-indigo-700 hover:bg-indigo-600 active:bg-amber-500 text-white font-extrabold py-2 rounded-xl text-xs shadow active:scale-95 flex items-center justify-center gap-1">
              ▼ Bawah
            </button>
            <button id="btnDPadRight" class="touch-none select-none w-24 bg-indigo-700 hover:bg-indigo-600 active:bg-amber-500 text-white font-extrabold py-2 rounded-xl text-xs shadow active:scale-95 flex items-center justify-center gap-1">
              Kanan ▶
            </button>
          </div>
        </div>
      </div>

      <!-- PANEL REFLEKSI ANALISIS SISWA -->
      <div id="reflectionPanelContainer" class="bg-slate-800 rounded-2xl border border-slate-700 p-3 shadow-lg flex flex-col flex-1">
        <div class="flex items-center justify-between pb-1.5 mb-1.5 border-b border-slate-700">
          <div class="flex items-center gap-1">
            <span id="panelStateIcon">🔒</span>
            <h3 class="text-xs font-brand font-bold text-slate-200">Refleksi Analisis (<span id="reflectionQuestionLabel">Soal 1</span>)</h3>
          </div>
          <span class="text-[10px] text-amber-300 font-mono">Min. 20 Kata</span>
        </div>

        <p class="text-[11px] text-slate-400 leading-tight mb-2">
          Jelaskan proses koding & debugging: konsep apa yang kamu gunakan dan bagaimana susunan kode yang benar?
        </p>

        <textarea id="studentExplanationInput" disabled rows="3" class="w-full text-xs p-2 rounded-xl bg-slate-900/80 border border-slate-600 text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-400 disabled:opacity-60 disabled:cursor-not-allowed resize-none" placeholder="🔒 Perbaiki/susun balok kode terlebih dahulu untuk membuka lembar analisis ini..."></textarea>

        <div class="flex items-center justify-between mt-1 text-[11px]">
          <span>Jumlah kata: <strong id="wordCounter" class="text-rose-400 font-mono">0</strong>/20</span>
          <span id="wordStatusNotice" class="text-rose-400 text-[10px] hidden">Kurang <span id="wordShortage">20</span> kata</span>
          <span id="wordSuccessNotice" class="text-emerald-400 text-[10px] hidden font-bold">Refleksi Memenuhi Syarat! ✅</span>
        </div>

        <!-- Next Challenge / Submit Button -->
        <button id="btn-next-challenge" disabled onclick="handleNextChallengeAction()" class="mt-2.5 w-full py-2 bg-slate-700 text-slate-400 font-brand font-bold text-xs rounded-xl shadow transition flex items-center justify-center gap-1.5 cursor-not-allowed">
          <span id="nextBtnLabel">Lanjut ke Soal Berikutnya (Soal 2)</span>
          <span>→</span>
        </button>
      </div>

    </div>
  </main>

  <!-- MODAL: BANTUAN (HINTS) BERJENJANG WAKTU -->
  <div id="hintsModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-indigo-500/50 max-w-lg w-full rounded-3xl p-5 sm:p-6 shadow-2xl relative text-slate-100">
      <div class="flex items-center justify-between pb-3 border-b border-slate-700">
        <div class="flex items-center gap-2">
          <span class="text-xl">💡</span>
          <h3 class="font-brand font-bold text-amber-300 text-base">Kotak Bantuan Detektif Cilik</h3>
        </div>
        <button onclick="closeHintModal()" class="w-7 h-7 flex items-center justify-center bg-slate-800 hover:bg-slate-700 rounded-full text-slate-400 hover:text-white font-bold text-sm">✕</button>
      </div>

      <p class="text-xs text-slate-300 my-3 leading-relaxed">
        Setiap 10 menit, bantuan baru akan otomatis terbuka untuk memandu analisismu tanpa membocorkan jawaban langsung.
      </p>

      <!-- Hints List Container -->
      <div id="hintsContainerList" class="space-y-2.5 max-h-[340px] overflow-y-auto pr-1">
        <!-- Rendered dynamically -->
      </div>

      <button onclick="closeHintModal()" class="w-full mt-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-brand font-bold text-xs rounded-xl shadow transition">
        Mengerti, Kembali ke Soal
      </button>
    </div>
  </div>

  <!-- JAVASCRIPT: SOUND ENGINE & AUDIO -->
  <script>
    class SoundEngine {
      constructor() {
        this.ctx = null;
      }
      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) {
            this.ctx = new AudioContext();
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }
      playTone(freq, type = 'sine', duration = 0.1, gainVal = 0.15) {
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
          gain.gain.setValueAtTime(gainVal, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + duration);
        } catch (e) {}
      }
      playSnap() {
        this.playTone(850, 'triangle', 0.08, 0.2);
      }
      playGrab() {
        this.playTone(480, 'sine', 0.06, 0.12);
      }
      playError() {
        this.playTone(180, 'sawtooth', 0.25, 0.2);
      }
      playStar() {
        this.playTone(980, 'sine', 0.12, 0.25);
        setTimeout(() => this.playTone(1320, 'sine', 0.18, 0.2), 60);
      }
      playBomb() {
        this.playTone(120, 'square', 0.4, 0.3);
      }
      playVictory() {
        [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
          setTimeout(() => this.playTone(freq, 'triangle', 0.2, 0.25), idx * 90);
        });
      }
      playSolveChime() {
        [440, 554.37, 659.25, 880, 1108.73].forEach((freq, idx) => {
          setTimeout(() => this.playTone(freq, 'triangle', 0.15, 0.2), idx * 75);
        });
      }
    }
    const audio = new SoundEngine();

    function triggerHaptic(duration = 40) {
      if (typeof navigator !== 'undefined' && navigator.vibrate) {
        try { navigator.vibrate(duration); } catch(e) {}
      }
    }
  </script>

