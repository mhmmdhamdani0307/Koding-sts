        hint: "Urutan langkah (algoritma sekuensial) sangat penting! Bayangkan kamu sendiri yang berjalan: apakah kamu melompat dulu sebelum ada batu di depanmu, atau melangkah mendekati batu baru melompat?",
        initialSlots: {
          seq1: "empty",
          seq2: "empty",
          seq3: "empty"
        },
        palette: [
          { id: "move_50_steps", type: "stack", label: "move (50) steps", color: "#4C97FF", stroke: "#3373CC" },
          { id: "jump", type: "stack", label: "jump", color: "#FF6680", stroke: "#DB4D68" },
